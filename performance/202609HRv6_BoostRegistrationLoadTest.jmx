        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="10_ProfileSettings (optional, toggle with -JincludeProfile)">
          <stringProp name="IfController.condition">${__P(includeProfile,true)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
