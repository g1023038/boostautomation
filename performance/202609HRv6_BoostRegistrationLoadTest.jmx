      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Username Generator">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters">count=${__P(totalUsers,0)} dob=2000-01-01 gender=any csv=${__P(csvfile,testusers.csv)}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.time.LocalDate
import java.time.format.DateTimeFormatter
import java.util.concurrent.ThreadLocalRandom

/* =========================================================================
 * BOOOST test-user generator for boost-auth-api load testing.
 * Produces: phone_number (+27 E.164), sa_id, date_of_birth, first_name,
 *           last_name, email  -&gt;  written to CSV, consumed by the main group.
 *
 * DEV/PPE BYPASS: users are stamped DOB 2000-01-01 by default. Those
 * identities skip SMS delivery, so /verify accepts any well-formed 6-digit
 * OTP (we send 123456). The SA ID is built from the same DOB, so ID and
 * date_of_birth always agree (ID starts 000101).
 *
 * PARAMETERS (Parameters box, space-separated key=value):
 *   count=100                number of users to generate
 *   count=0                  how many to generate -- defaults to 0, i.e. GENERATE
 *                            NOTHING and leave any existing csv file alone. This
 *                            thread group runs on every invocation regardless of
 *                            which scenario group you're targeting that run, so a
 *                            non-zero default here would silently overwrite (with
 *                            zero or the wrong rows) a pool a previous run already
 *                            registered -- confirmed live: running with regUsers=0
 *                            while chaining off a prior default clobbered a
 *                            just-registered identity's csv row with an empty one.
 *                            Pass -JtotalUsers explicitly when you actually want to
 *                            (re)generate a pool.
 *   dob=2000-01-01           fixed DOB (default; keeps the SMS bypass)
 *   dobStart / dobEnd        use a real range instead (needs real OTP flow)
 *   gender=any               male | female | any
 *   citizen=0                0 = SA citizen, 1 = permanent resident
 *   csv=testusers.csv        output file (relative =&gt; JMeter bin dir)
 *   append=false             append instead of overwrite
 * ========================================================================= */

// ---- Parse Parameters -------------------------------------------------------
def params = [:]
if (Parameters?.trim()) {
    Parameters.trim().split(&quot;\\s+&quot;).each { tok -&gt;
        def kv = tok.split(&quot;=&quot;, 2)
        if (kv.length == 2) params[kv[0].trim()] = kv[1].trim()
    }
}

int     count     = (params.count     ?: &quot;0&quot;).toInteger()
if (count &lt;= 0) {
    log.info(&quot;Username Generator: count=0 (or unset), nothing to generate -- leaving any existing csv file as-is. Pass -JtotalUsers=N to actually (re)generate a pool.&quot;)
    return
}
String  genderReq = (params.gender    ?: &quot;any&quot;).toLowerCase()
String  citizen   = (params.citizen   ?: &quot;0&quot;)
String  csvName   = (params.csv       ?: &quot;testusers.csv&quot;)
boolean append    = (params.append    ?: &quot;false&quot;).toBoolean()

def fmt = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)
boolean useRange   = (params.dob == null) &amp;&amp; (params.dobStart != null || params.dobEnd != null)
LocalDate dobFixed = LocalDate.parse((params.dob ?: &quot;2000-01-01&quot;), fmt)
LocalDate dobStart = LocalDate.parse((params.dobStart ?: &quot;2000-01-01&quot;), fmt)
LocalDate dobEnd   = LocalDate.parse((params.dobEnd   ?: &quot;2000-01-01&quot;), fmt)

// ---- Name pools -------------------------------------------------------------
def firstNames = [&quot;Thabo&quot;,&quot;Lerato&quot;,&quot;Sipho&quot;,&quot;Nomsa&quot;,&quot;Kagiso&quot;,&quot;Ayanda&quot;,&quot;Naledi&quot;,
                  &quot;Tebogo&quot;,&quot;Lindiwe&quot;,&quot;Bongani&quot;,&quot;Zanele&quot;,&quot;Mpho&quot;,&quot;Karabo&quot;,&quot;Refilwe&quot;,
                  &quot;Thandi&quot;,&quot;Sarah&quot;,&quot;David&quot;,&quot;Emily&quot;,&quot;Michael&quot;,&quot;Aisha&quot;,&quot;Priya&quot;,&quot;Johan&quot;,&quot;Anele&quot;]
def surnames   = [&quot;Nkosi&quot;,&quot;Dlamini&quot;,&quot;Molefe&quot;,&quot;Khumalo&quot;,&quot;Mokoena&quot;,&quot;Ndlovu&quot;,&quot;Mahlangu&quot;,
                  &quot;Sithole&quot;,&quot;Botha&quot;,&quot;Naidoo&quot;,&quot;Pillay&quot;,&quot;Smith&quot;,&quot;Jacobs&quot;,
                  &quot;Maluleke&quot;,&quot;Tshabalala&quot;,&quot;Zulu&quot;,&quot;Mabaso&quot;,&quot;Kruger&quot;,&quot;Adams&quot;]

def rnd = ThreadLocalRandom.current()

def randomDob = { -&gt;
    if (!useRange) return dobFixed
    long from = dobStart.toEpochDay()
    long to   = dobEnd.toEpochDay()
    return LocalDate.ofEpochDay(rnd.nextLong(from, to + 1))
}

// SA ID checksum (Luhn variant over the first 12 digits)
def luhnCheck = { String twelve -&gt;
    int odd = 0
    for (int i = 0; i &lt; 12; i += 2) odd += Character.getNumericValue(twelve.charAt(i))
    StringBuilder evenDigits = new StringBuilder()
    for (int i = 1; i &lt; 12; i += 2) evenDigits.append(twelve.charAt(i))
    int evenTimesTwo = Integer.parseInt(evenDigits.toString()) * 2
    String etoStr = evenTimesTwo.toString()
    int evenSum = 0
    for (int i = 0; i &lt; etoStr.length(); i++) evenSum += Character.getNumericValue(etoStr.charAt(i))
    int total = odd + evenSum
    return ((10 - (total % 10)) % 10).toString()
}

def buildId = { LocalDate dob, String gender -&gt;
    String yymmdd = dob.format(DateTimeFormatter.ofPattern(&quot;yyMMdd&quot;))
    int seq
    if (gender == &quot;female&quot;)    seq = rnd.nextInt(0, 5000)
    else if (gender == &quot;male&quot;) seq = rnd.nextInt(5000, 10000)
    else                       seq = rnd.nextInt(0, 10000)
    String ssss = String.format(&quot;%04d&quot;, seq)
    String first12 = yymmdd + ssss + citizen + &quot;8&quot;
    return first12 + luhnCheck(first12)
}

// SA mobile number in +27 E.164 format
def buildCell = { -&gt;
    String[] pfx = [&quot;60&quot;,&quot;61&quot;,&quot;62&quot;,&quot;63&quot;,&quot;64&quot;,&quot;65&quot;,&quot;71&quot;,&quot;72&quot;,&quot;73&quot;,&quot;74&quot;,&quot;76&quot;,&quot;78&quot;,&quot;79&quot;,&quot;81&quot;,&quot;82&quot;,&quot;83&quot;,&quot;84&quot;]
    StringBuilder sb = new StringBuilder(&quot;+27&quot;).append(pfx[rnd.nextInt(pfx.length)])
    for (int i = 0; i &lt; 7; i++) sb.append(rnd.nextInt(10))
    return sb.toString()
}

// ---- Generate ---------------------------------------------------------------
def profiles = []
for (int i = 0; i &lt; count; i++) {
    LocalDate dob = randomDob()
    String g  = (genderReq in [&quot;male&quot;,&quot;female&quot;]) ? genderReq : (rnd.nextBoolean() ? &quot;male&quot; : &quot;female&quot;)
    String fn = firstNames[rnd.nextInt(firstNames.size())]
    String ln = surnames[rnd.nextInt(surnames.size())]
    String id = buildId(dob, g)
    String email = (fn + &quot;.&quot; + ln + rnd.nextInt(100000) + &quot;@loadtest.booost.com&quot;).toLowerCase().replace(&quot; &quot;, &quot;&quot;)
    profiles &lt;&lt; [ phone:buildCell(), id:id, dob:dob.format(fmt), first:fn, last:ln, email:email ]
}

// ---- Resolve CSV path to absolute and publish it as a property --------------
File csvFile = new File(csvName)
if (!csvFile.isAbsolute()) csvFile = new File(System.getProperty(&quot;user.dir&quot;), csvName)
props.put(&quot;csvfile&quot;, csvFile.getAbsolutePath())

boolean writeHeader = !append || !csvFile.exists() || csvFile.length() == 0
def writer = new FileWriter(csvFile, append)
try {
    if (writeHeader) writer.write(&quot;phone_number,sa_id,date_of_birth,first_name,last_name,email\n&quot;)
    profiles.each { p -&gt; writer.write(&quot;${p.phone},${p.id},${p.dob},${p.first},${p.last},${p.email}\n&quot;) }
} finally {
    writer.close()
}

log.info(&quot;Generated ${profiles.size()} users -&gt; ${csvFile.getAbsolutePath()}&quot;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- ================================================================
           REGISTRATION LOAD (Test 5 in the Oct 2026 brief, also P0 #2):
           Fresh, never-registered identities. Full happy path: otp -> verify
           (expect registered==false) -> register -> status. recycle=false +
           stopThread=true: each identity registers exactly once, the thread
           stops cleanly once the pool is exhausted rather than looping back
           over already-registered rows (which would just exercise Login
           behaviour under a different label). Suggested progression:
           100 -> 250 -> 500 -> 1,000 via separate invocations. Also serves
           as Test 1's registration baseline, just run at low -JregUsers.
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Registration Load">
        <stringProp name="ThreadGroup.num_threads">${__P(regUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(regRampup,30)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(regLoops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Fresh Identities CSV">
          <stringProp name="filename">${__P(csvfile,testusers.csv)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">phone_number,sa_id,date_of_birth,first_name,last_name,email</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="01_RequestOTP">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/auth/otp">
            <stringProp name="HTTPSampler.path">/v1/auth/otp</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;phone_number&quot;: &quot;${phone_number}&quot;,&#xd;
  &quot;sa_id&quot;: { &quot;number&quot;: &quot;${sa_id}&quot; },&#xd;
  &quot;date_of_birth&quot;: &quot;${date_of_birth}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract otp_token">
              <stringProp name="JSONPostProcessor.referenceNames">otp_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.otp_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">OTP_TOKEN_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">/otp did not return 200 -- check rate limits (3/phone/hr, 10/IP/hr) before assuming an app bug</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="02_VerifyOTP">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/auth/verify">
            <stringProp name="HTTPSampler.path">/v1/auth/verify</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;otp_token&quot;: &quot;${otp_token}&quot;,&#xd;
  &quot;otp&quot;: &quot;${otpCode}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract access_token">
              <stringProp name="JSONPostProcessor.referenceNames">access_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">ACCESS_TOKEN_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract refresh_token (absent for unregistered)">
              <stringProp name="JSONPostProcessor.referenceNames">refresh_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.refresh_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">REFRESH_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract registered flag" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">registered</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.member.registered</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">false</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">/verify did not return 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="03_Register (only if unregistered)">
          <stringProp name="IfController.condition">${__groovy(&quot;${registered}&quot; != &quot;true&quot;)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="03_Register">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/identity/register">
              <stringProp name="HTTPSampler.path">/v1/identity/register</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&#xd;
  &quot;first_name&quot;: &quot;${first_name}&quot;,&#xd;
  &quot;last_name&quot;: &quot;${last_name}&quot;,&#xd;
  &quot;email&quot;: &quot;${email}&quot;,&#xd;
  &quot;terms_version&quot;: &quot;${termsVersion}&quot;&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer Auth" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${access_token}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract access_token (rotated)" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">access_token</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">ACCESS_TOKEN_NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract refresh_token" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">refresh_token</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.refresh_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">REFRESH_NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract memberId + status" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">memberId;memberStatus</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.member.id;$.member.status</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">MEMBER_NOT_FOUND;unknown</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200 or 201" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="1478545279">20[01]</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">/register did not return 200/201</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">1</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="04_Status" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <!-- Single status read to measure the endpoint's own performance under
               load. Deliberately NOT a poll-until-active loop here: the API docs'
               "poll a few seconds apart with backoff" guidance is for application
               correctness, not for a load-test thread: a real polling loop would
               make per-thread duration unpredictable and distort throughput/RPS
               numbers. Functional pending->active polling belongs in a functional
               test (mobile-tests/), not this load test. -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /v1/identity/status" enabled="true">
            <stringProp name="HTTPSampler.path">/v1/identity/status</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer Auth" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${access_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract status" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">memberStatus</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.member.status</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">unknown</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">/status did not return 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
          <stringProp name="ConstantTimer.delay">300</stringProp>
          <stringProp name="RandomTimer.range">500</stringProp>
        </UniformRandomTimer>
        <hashTree/>
      <!-- ================================================================
           BASELINE (Test 1 in the Oct 2026 brief): minimal-load response
           time baseline before introducing concurrency. Priority per the
           brief is Login -> Home -> Future Boost; Home/Future Boost live
           in Progressive Load's Core Browsing Loop (blocked on the
           GraphQL gateway, see TestPlan comment), not duplicated here;
           this group covers the Login/Profile/Logout part of the
           baseline. Registration's own baseline is just "Registration
           Load" run at low -JregUsers, not a separate group.
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Baseline">
        <stringProp name="ThreadGroup.num_threads">${__P(baselineUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(baselineRampup,10)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(baselineLoops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Registered Pool CSV">
          <stringProp name="filename">${__P(csvfile,testusers.csv)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">phone_number,sa_id,date_of_birth,first_name,last_name,email</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="01_RequestOTP">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/auth/otp">
            <stringProp name="HTTPSampler.path">/v1/auth/otp</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;phone_number&quot;: &quot;${phone_number}&quot;,&#xd;
  &quot;sa_id&quot;: { &quot;number&quot;: &quot;${sa_id}&quot; },&#xd;
  &quot;date_of_birth&quot;: &quot;${date_of_birth}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract otp_token">
              <stringProp name="JSONPostProcessor.referenceNames">otp_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.otp_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">OTP_TOKEN_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">/otp did not return 200 -- check rate limits (3/phone/hr, 10/IP/hr) before assuming an app bug</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="02_VerifyOTP (session created)">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/auth/verify">
            <stringProp name="HTTPSampler.path">/v1/auth/verify</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;otp_token&quot;: &quot;${otp_token}&quot;,&#xd;
  &quot;otp&quot;: &quot;${otpCode}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract access_token">
              <stringProp name="JSONPostProcessor.referenceNames">access_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">ACCESS_TOKEN_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract refresh_token">
              <stringProp name="JSONPostProcessor.referenceNames">refresh_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.refresh_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">REFRESH_NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract registered flag">
              <stringProp name="JSONPostProcessor.referenceNames">registered</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.member.registered</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">false</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">/verify did not return 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="ProfileRead (optional, toggle with -JincludeProfile)">
          <stringProp name="IfController.condition">${__P(includeProfile,true)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="ProfileRead">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /v1/identity/profile">
              <stringProp name="HTTPSampler.path">/v1/identity/profile</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer Auth">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${access_token}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">/profile did not return 200 -- a 403 here means this session wasn't actually registered, see the assertion on /verify above</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Logout (only if refresh_token present)">
          <stringProp name="IfController.condition">${__groovy(vars.get(&quot;refresh_token&quot;) != null &amp;&amp; vars.get(&quot;refresh_token&quot;).startsWith(&quot;RT&quot;))}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Logout">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /v1/auth/logout">
              <stringProp name="HTTPSampler.path">/v1/auth/logout</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&#xd;
  &quot;refresh_token&quot;: &quot;${refresh_token}&quot;&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <!-- No Authorization header: the refresh_token itself is the
                   credential here, same as /auth/refresh. -->
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 204">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="204">204</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">/logout did not return 204</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time">
          <stringProp name="ConstantTimer.delay">300</stringProp>
          <stringProp name="RandomTimer.range">500</stringProp>
        </UniformRandomTimer>
        <hashTree/>
      </hashTree>

      </hashTree>

      <!-- ================================================================
           PROGRESSIVE LOAD (Test 2 in the Oct 2026 brief): Login/auth
           (P0 #1) + the full Core Browsing Loop, stepped 250/500/1000/
           2000/3000/4000/5000 across separate invocations.
           Needs an ALREADY-REGISTERED pool: run "Registration Load"
           once first against the same -Jcsvfile to create it. recycle=true
           so repeated loop iterations cycle login/logout against the same
           pool (brief: "include logout/login cycles where practical");
           see the rate-limit warning in the TestPlan comment before sizing
           -JprogUsers/-JprogLoops against a given pool size.
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Progressive Load">
        <stringProp name="ThreadGroup.num_threads">${__P(progUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(progRampup,30)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
