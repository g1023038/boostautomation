      <!-- ================================================================
           4 - MIXED JOURNEY (Test 3 in the brief: 5,000-user mixed workload)
           Disabled (num_threads defaults to 0): 7 of its 9 branches need
           endpoints from services whose docs weren't provided (only
           boost-auth-api was). Scaffolded with the brief's own percentages
           so wiring it up later is a data edit: replace each placeholder's
           ${appApiHost}/TODO path + method with the real ones, no
           restructuring needed. Login (20%) and Profile (5%) are already
           real, duplicated from group 2 above rather than shared via a
           Module Controller, since a hand-written ModuleController
           node_path cannot be verified without opening this file in a real
           JMeter GUI first.

           Per-branch target share of iterations (NOT wired to an actual
           weighted controller yet; ThroughputController "Percent
           Executions" is the right tool once every branch is real; adding
           it now for 7 placeholder branches would be complexity with
           nothing real to weight):
             20% Login/authentication   (real, see TransactionController below)
             20% Home/navigation        (TODO: needs home/navigation API docs)
             20% Future Boost           (TODO: needs Future Boost API docs)
             10% Balance/history        (TODO: needs balance/transaction API docs)
             10% Deals                  (TODO: needs Deals/Rewards API docs)
              5% Voucher browsing       (TODO: browse/catalogue only, no purchase)
              5% BAM                    (TODO: needs Boost-a-Million API docs)
              5% Partner/loyalty        (TODO: needs partner/loyalty API docs)
              5% Profile/settings       (real, GET /v1/identity/profile, see below;
                                          PATCH /v1/identity/profile is documented too
                                          but brief says keep this read-based for now)
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="4 - Mixed Journey (Test 3, needs app-api docs for 7 of 9 branches)">
        <stringProp name="ThreadGroup.num_threads">${__P(mixedUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(mixedRampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(mixedLoops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
