      <!-- ================================================================
           MIXED JOURNEY (Test 3 in the brief: 5,000-user mixed workload)
           Disabled (num_threads defaults to 0), but ALL 9 OF 9 BRANCHES
           ARE NOW REAL AND CONFIRMED LIVE through this exact file:
           found via GraphQL schema introspection against the confirmed
           gateway (see the TestPlan-level comment above), then each
           query individually verified 200 with real PPE data. Duplicated
           from the Progressive Load group's content rather than shared
           via a Module Controller, since a hand-written ModuleController
           node_path couldn't be resolved in several attempts without the
           JMeter GUI.

           Per-branch target share of iterations: NOW WIRED to a real
           ThroughputController per branch ("Percent Executions" mode,
           style=1, FloatProperty percentThroughput), one per-iteration
           choice among the 9 rather than hitting all 9 every time.
           Verified live over 30 iterations: 6/6/6/3/3/1/1/1/1 hits for
           the 20/20/20/10/10/5/5/5/5 branches respectively: exactly
           proportional (ThroughputController doesn't guarantee an exact
           partition at low iteration counts, some iterations fire no
           branch at all, which is why counts don't sum to 30; ratios
           converge precisely at real scale):
             20% Login/authentication   (real, CONFIRMED live)
             20% Home/navigation        (real, DashboardPage, CONFIRMED live)
             20% Future Boost           (real, FutureBoostPage, CONFIRMED live)
             10% Balance/history        (real, BalancePage, CONFIRMED live)
             10% Deals                  (real, DealsPage, CONFIRMED live)
              5% Voucher browsing       (real, BoostBuyPage, CONFIRMED live;
                                          browse/landing only, no purchase)
              5% BAM                    (real, BoostAMillionPage, CONFIRMED live)
              5% Partner/loyalty        (real, PartnerList, CONFIRMED live)
              5% Profile/settings       (real, GET /v1/identity/profile,
                                          CONFIRMED live; PATCH is documented
                                          too but brief says keep this
                                          read-based for now)
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Mixed Journey (5000 User)">
        <stringProp name="ThreadGroup.num_threads">${__P(mixedUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(mixedRampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(mixedLoops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
