      <!-- ================================================================
           3 - PAYMENTS ORDER FLOW: OUT OF SCOPE for the Oct 2026 round
           per the brief ("Payments are out of scope for tomorrow"). Left
           intact for whenever it's back in scope; num_threads now defaults
           to 0 so it does nothing unless explicitly opted into with
           -JpayUsers=<N> (previously defaulted to 10, i.e. ran even when
           not wanted).
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Payments Order Flow (opt-in, out of scope this round)" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(payUsers,0)}</stringProp>
