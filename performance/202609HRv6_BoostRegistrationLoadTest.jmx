        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time">
          <stringProp name="ConstantTimer.delay">300</stringProp>
          <stringProp name="RandomTimer.range">500</stringProp>
        </UniformRandomTimer>
        <hashTree/>
      </hashTree>

      <!-- ================================================================
           SOAK ENDURANCE (Test 8 in the Oct 2026 brief): same mixed
           workload content as Mixed Journey: same 9 branches, all 9
           now real and CONFIRMED live (see the Mixed Journey comment
           above for the full breakdown), but DURATION-based instead of loop-count-based:
           ThreadGroup.scheduler=true + ThreadGroup.duration run a stable
           load for a fixed time window rather than a fixed number of
           iterations, with the inner LoopController set to infinite
           (loops=-1) so each thread keeps cycling until the duration
           elapses rather than finishing one pass and sitting idle. Point
           is to surface what a short run can't: steadily increasing
           memory, connection/resource exhaustion, or response time
           degradation over a sustained window. Default duration is 1800s
           (30 min); override with -JsoakDuration for the real window.
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Soak Endurance">
        <stringProp name="ThreadGroup.num_threads">${__P(soakUsers,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(soakRampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(soakDuration,1800)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Registered Pool CSV">
          <stringProp name="filename">${__P(csvfile,testusers.csv)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">phone_number,sa_id,date_of_birth,first_name,last_name,email</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>

